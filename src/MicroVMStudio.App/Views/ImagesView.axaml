<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MicroVMStudio.App.ViewModels"
             xmlns:app="using:MicroVMStudio.App"
             xmlns:models="using:MicroVMStudio.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MicroVMStudio.App.Views.ImagesView"
             x:DataType="vm:ImagesViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="Images" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="11" Foreground="#6E7781" TextWrapping="Wrap" MaxWidth="420"
                   Text="Distros are discovered from images/rootfs/distros/. Drop in a folder with a Dockerfile and it appears here." />

        <Border Grid.Row="1" Background="#1F2126" CornerRadius="6" Padding="14" Margin="0,12">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Build" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Distros}" SelectedItem="{Binding SelectedDistro}"
                              MinWidth="180" PlaceholderText="No distros found"
                              IsEnabled="{Binding !Building}" />
                    <Button Content="Build rootfs" Classes="accent"
                            Command="{Binding BuildRootfsCommand}" IsEnabled="{Binding !Building}" />
                    <Button Content="Build kernel"
                            Command="{Binding BuildKernelCommand}" IsEnabled="{Binding !Building}" />
                    <Button Content="Cancel" Command="{Binding CancelBuildCommand}"
                            IsVisible="{Binding Building}" />
                    <TextBlock Text="building…" Foreground="#BF8B00" VerticalAlignment="Center"
                               IsVisible="{Binding Building}" />
                </StackPanel>

                <Border Background="#111317" CornerRadius="4" Padding="8" MaxHeight="200"
                        IsVisible="{Binding BuildLog.Count}">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding BuildLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="11"
                                               Foreground="#C9D1D9" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#1F2126" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="14,10" ColumnDefinitions="2*,90,110,90,*,160,90">
                    <TextBlock Text="NAME" FontSize="11" Foreground="#8A8F98" />
                    <TextBlock Grid.Column="1" Text="KIND" FontSize="11" Foreground="#8A8F98" />
                    <TextBlock Grid.Column="2" Text="DIGEST" FontSize="11" Foreground="#8A8F98" />
                    <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" Foreground="#8A8F98" />
                    <TextBlock Grid.Column="4" Text="DISTRO" FontSize="11" Foreground="#8A8F98" />
                    <TextBlock Grid.Column="5" Text="BUILT" FontSize="11" Foreground="#8A8F98" />
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageRowViewModel">
                                <Border BorderBrush="#2A2D33" BorderThickness="0,1,0,0" Padding="14,8">
                                    <Grid ColumnDefinitions="2*,90,110,90,*,160,90" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   Foreground="#8A8F98" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ShortDigest}"
                                                   FontFamily="monospace" FontSize="11"
                                                   Foreground="#8A8F98" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Size}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding DistroDir}"
                                                   Foreground="#8A8F98" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BuiltAt}" FontSize="12" />
                                            <TextBlock Text="{Binding UsageLabel}" FontSize="11"
                                                       Foreground="#6E7781" />
                                        </StackPanel>
                                        <Button Grid.Column="6" Content="Delete" HorizontalAlignment="Right"
                                                IsEnabled="{Binding CanDelete}"
                                                Command="{Binding $parent[ItemsControl].((vm:ImagesViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="10" Margin="0,12,0,0">
            <Border Background="#5A1A1A" Padding="12,8" CornerRadius="4"
                    IsVisible="{Binding Error, Converter={x:Static app:Converters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" />
            </Border>

            <Expander Header="Import an existing image">
                <StackPanel Spacing="10" Margin="0,8">
                    <TextBlock FontSize="11" Foreground="#6E7781" TextWrapping="Wrap"
                               Text="Registers a kernel or rootfs file that was built elsewhere. The file is copied into the studio's image store; the original is left alone." />
                    <Grid ColumnDefinitions="*,12,180,12,140,12,Auto">
                        <TextBox Text="{Binding ImportPath}" PlaceholderText="/path/to/rootfs.ext4" />
                        <TextBox Grid.Column="2" Text="{Binding ImportName}" PlaceholderText="image name" />
                        <ComboBox Grid.Column="4" SelectedItem="{Binding ImportKind}"
                                  HorizontalAlignment="Stretch">
                            <models:ImageKind>Kernel</models:ImageKind>
                            <models:ImageKind>Rootfs</models:ImageKind>
                        </ComboBox>
                        <Button Grid.Column="6" Content="Import" Command="{Binding ImportCommand}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
